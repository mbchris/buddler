# Copy to .env (or run scripts/bootstrap_env.py, which generates the secrets).

# --- Docker / Postgres -------------------------------------------------------
DB_PORT=5432
MCP_PORT=8001
API_PORT=8000
POSTGRES_PASSWORD=
POSTGRES_DB=buddler
APP_RW_PASSWORD=
MCP_RO_PASSWORD=
DATABASE_URL=postgresql+asyncpg://app_rw:CHANGE_ME@localhost:5432/buddler
TEST_DATABASE_URL=postgresql+asyncpg://app_rw:CHANGE_ME@localhost:5432/buddler_test
TEST_MCP_RO_DATABASE_URL=postgresql+asyncpg://mcp_ro:CHANGE_ME@localhost:5432/buddler_test
MCP_URL=http://localhost:8001/sse

# --- REST API ----------------------------------------------------------------
API_KEY=

# --- LLM gateway (Requesty, OpenAI-compatible) ---------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://router.requesty.ai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536

# --- Location / weather (Open-Meteo, no key) -----------------------------------
TIMEZONE=Europe/Berlin
LOCATION_LATITUDE=52.52
LOCATION_LONGITUDE=13.405
# fake = canned weather for reproducible demos; open_meteo = real forecast.
WEATHER_PROVIDER=fake
FAKE_WEATHER=cloudy
WEATHER_FORECAST_HOURS=6

# --- Homematic (CCU-Jack) -------------------------------------------------------
# fake = simulated home (living room, bedroom, office) for offline demos.
HOMEMATIC_PROVIDER=fake
HOMEMATIC_ENDPOINT=https://homematic-raspi:2122
HOMEMATIC_USERNAME=
HOMEMATIC_PASSWORD=
# CCU-Jack uses a self-signed certificate by default.
HOMEMATIC_VERIFY_TLS=false
# Room -> climate channel map; find addresses with `buddler home discover`.
HOMEMATIC_ROOMS={"living room": {"climate": "000A1B2C3D4E5F:1", "aliases": ["wohnzimmer"]}}
DEFAULT_ROOM=living room

# --- Actuation bounds (ADR 0002); empty list = never write --------------------
ACTUATION_ROOMS=["living room"]
SETPOINT_MIN_C=16
SETPOINT_MAX_C=24
SETPOINT_MAX_DELTA_C=2
ACTUATION_MAX_WRITES_PER_RUN=1
ACTUATION_COOLDOWN_MIN=30
DRY_RUN=false
